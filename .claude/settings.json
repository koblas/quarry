{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(git diff *)",
      "Bash(git grep *)",
      "Bash(git log *)",
      "Bash(git ls-tree *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(git worktree list*)",
      "Bash(go build *)",
      "Bash(go doc *)",
      "Bash(go list *)",
      "Bash(go mod *)",
      "Bash(go run *)",
      "Bash(go test *)",
      "Bash(go tool cover -func *)",
      "Bash(go version)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint run *)",
      "Bash(shasum *)",
      "mcp__ccd_pr__get_status",
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit"
    ],
    "deny": ["Bash(rm -rf *)", "Bash(curl *)", "Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && command -v direnv >/dev/null && direnv export bash >> \"$CLAUDE_ENV_FILE\" 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Loading devenv environment..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  }
}
